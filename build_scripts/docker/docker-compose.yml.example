name: biaoke

services:
  biaoke:
    # --- BUILD OPTION ---
    # Build locally when testing changes from this checkout.
    # Run docker compose from the repository root.
    build:
      context: .
      dockerfile: build_scripts/docker/Dockerfile

    # --- IMAGE OPTION ---
    # To use the pre-built image instead, remove the build section and uncomment:
    # image: vicwomg/biaoke:latest
    image: biaoke-local:latest

    container_name: Biaoke
    environment:
      BIAOKE_LOGIN: ${BIAOKE_LOGIN:-}
      BIAOKE_PASSWORD: ${BIAOKE_PASSWORD:-}
      BIAOKE_PUBLIC_URL: ${BIAOKE_PUBLIC_URL:-http://<YOUR_LAN_IP>:5555}
      # Optional: pass extra yt-dlp args. For authenticated YouTube downloads,
      # export youtube.com cookies to ./data/youtube-cookies.txt and set:
      # BIAOKE_YTDL_ARGS=--cookies /home/biaoke/.biaoke/youtube-cookies.txt
      BIAOKE_YTDL_ARGS: ${BIAOKE_YTDL_ARGS:-}
      # Optional GPU scoring service URL. Leave empty to use the built-in CPU fallback.
      BIAOKE_SCORING_SERVICE_URL: ${BIAOKE_SCORING_SERVICE_URL:-http://scoring:8765/analyze}
      # Optional AI guide review. Uses DeepSeek V4 Flash by default.
      DEEPSEEK_API_KEY: ${DEEPSEEK_API_KEY:-}
      DEEPSEEK_MODEL: ${DEEPSEEK_MODEL:-deepseek-v4-flash}
      DEEPSEEK_BASE_URL: ${DEEPSEEK_BASE_URL:-https://api.deepseek.com}
      DEEPSEEK_TIMEOUT: ${DEEPSEEK_TIMEOUT:-90}

    # --- COMMAND CONFIGURATION ---
    # -u: Required for the QR code to work on other devices.
    #     Replace <YOUR_LAN_IP> with your computer's actual IP (e.g., 192.168.1.50)
    # --config-file-path: Ensures settings are saved to the mounted volume
    # For Cloudflare Tunnel, set BIAOKE_PUBLIC_URL in .env to your public
    # https:// hostname after creating the tunnel route.
    entrypoint:
      - /bin/sh
      - -c
      - |
        set -- -d /app/biaoke-songs/ --headless -u "$${BIAOKE_PUBLIC_URL:-http://<YOUR_LAN_IP>:5555}"
        if [ -n "$${BIAOKE_YTDL_ARGS:-}" ]; then
          set -- "$$@" --ytdl-args "$${BIAOKE_YTDL_ARGS}"
        fi
        exec biaoke "$$@"

    # --- VOLUMES ---
    # The <local_directory>:<container_directory> format is used.
    # You should only need to change <local_directory>
    # You can change the <local_directory> to an absolute path (e.g., C:/Music or /home/pi/Music)
    # Relative current directory paths (./) are used here for simplicity.
    volumes:
      - ./songs:/app/biaoke-songs      # Songs will be saved here
      - ./data:/home/biaoke/.biaoke # Data, including your config, will be saved here

    # --- PORTS ---
    # Map host port 5555 to container port 5555
    ports:
      - "5555:5555"

    restart: unless-stopped

    networks:
      - biaoke

    # Logging limits to prevent disk filling
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  scoring:
    # GPU scoring service for real microphone-based scoring. Requires NVIDIA
    # Container Toolkit on the host.
    build:
      context: .
      dockerfile: build_scripts/docker/scoring.Dockerfile
    image: biaoke-scoring:latest
    container_name: Biaoke-Scoring
    gpus: all
    runtime: nvidia
    environment:
      NVIDIA_VISIBLE_DEVICES: all
      NVIDIA_DRIVER_CAPABILITIES: compute,utility
    restart: unless-stopped
    networks:
      - biaoke
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  cloudflared:
    # Cloudflare Tunnel connector. Create a remotely-managed tunnel in the
    # Cloudflare dashboard, then paste its token into CLOUDFLARED_TUNNEL_TOKEN
    # in .env.
    image: cloudflare/cloudflared:latest
    container_name: Biaoke-Cloudflared
    environment:
      TUNNEL_TOKEN: ${CLOUDFLARED_TUNNEL_TOKEN:-}
    command: >
      tunnel --no-autoupdate --protocol ${CLOUDFLARED_PROTOCOL:-http2} run
    depends_on:
      - biaoke
    restart: unless-stopped
    # Share Biaoke's network namespace so remotely-managed Cloudflare
    # origins can use http://localhost:5555.
    network_mode: "service:biaoke"

    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

networks:
  biaoke:
    driver: bridge
